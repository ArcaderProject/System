#!/bin/bash
set -euxo pipefail

ARCADER_USER=arcader
USER_HOME=/home/$ARCADER_USER

useradd -m -s /bin/bash -G video,input,tty,audio,render,plugdev $ARCADER_USER
passwd -d $ARCADER_USER
chown -R $ARCADER_USER:$ARCADER_USER $USER_HOME

DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends /opt/arcader/arcader.deb
rm -rf /opt/arcader

mkdir -p $USER_HOME/.config/openbox
cat > $USER_HOME/.config/openbox/autostart <<'EOF'
#!/bin/bash

pulseaudio --start &

xset s off
xset -dpms
xset s noblank

unclutter -idle 0.1 -root &

picom -b 2>/dev/null || true

sleep 2
systemctl --user start arcaderd.service 2>/dev/null || /usr/bin/arcaderd &
sleep 1

/usr/bin/arcaderui --fullscreen &
EOF
chmod +x $USER_HOME/.config/openbox/autostart

cat > $USER_HOME/.config/openbox/menu.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Openbox 3">
    <item label="Arcader">
      <action name="Execute">
        <command>/usr/bin/arcaderui</command>
      </action>
    </item>
  </menu>
</openbox_menu>
EOF

mkdir -p $USER_HOME/.config/autostart
cat > $USER_HOME/.config/autostart/pulseaudio.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=PulseAudio
Exec=pulseaudio --start
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
EOF

cat > $USER_HOME/.xinitrc <<'EOF'
#!/bin/bash
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources
exec openbox-session
EOF
chmod +x $USER_HOME/.xinitrc

chown -R $ARCADER_USER:$ARCADER_USER $USER_HOME/.config $USER_HOME/.xinitrc

plymouth-set-default-theme -R arcader

systemctl set-default multi-user.target

chmod 755 /usr/local/sbin/arcader-install
chmod 440 /etc/sudoers.d/arcader-installer
chown root:root /etc/sudoers.d/arcader-installer

rm -f /var/lib/systemd/linger/$ARCADER_USER

for n in 2 3 4 5 6; do
  systemctl mask "getty@tty${n}.service" || true
done
