#!/bin/bash
set -euo pipefail

DRY_RUN=0
ROTATE=normal
KEYMAP=us
TARGET=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --rotate)  ROTATE="$2"; shift ;;
    --keymap)  KEYMAP="$2"; shift ;;
    -*) echo "ERROR: unknown option '$1'" >&2; exit 2 ;;
    *)  TARGET="$1" ;;
  esac
  shift
done

case "$ROTATE" in normal|inverted) ;; *) ROTATE=normal ;; esac
case "$KEYMAP" in ''|*[!a-z0-9]*) KEYMAP=us ;; esac

[ -n "$TARGET" ] || { echo "ERROR: no target disk given" >&2; exit 2; }

if [ "${EUID:-$(id -u)}" -ne 0 ]; then
  echo "ERROR: must run as root" >&2
  exit 2
fi

emit() {
  local f="$1"; shift
  printf '@@P %s %s\n' "$f" "$*"
}

if [ "$DRY_RUN" -eq 1 ]; then
  echo "DRY RUN: no changes will be made to /dev/$TARGET"
  echo "[1/6] Partitioning /dev/$TARGET ...";  emit 0.02 "Partitioning disk"; sleep 1
  echo "[2/6] Formatting filesystems ...";      emit 0.07 "Formatting filesystems"; sleep 1
  echo "[3/6] Copying system to disk ...";      emit 0.10 "Scanning system files…"; sleep 1
  for p in 4 17 33 48 62 77 89 100; do
    frac=$(awk -v p="$p" 'BEGIN{printf "%.4f", 0.10 + 0.75 * p / 100}')
    emit "$frac" "Copying system to disk — ${p}%"
    sleep 0.3
  done
  echo "[4/6] Preparing chroot ...";            emit 0.86 "Preparing chroot"; sleep 1
  echo "[5/6] Installing bootloader and regenerating initramfs ..."; emit 0.90 "Installing bootloader"; sleep 1
  echo "[6/6] Unmounting ...";                   emit 0.97 "Unmounting"; sleep 1
  echo "Install complete (dry run)."
  exit 0
fi

LIVE_PART="$(findmnt -no SOURCE /run/live/medium 2>/dev/null || true)"
LIVE_DEV=""
if [ -n "$LIVE_PART" ]; then
  LIVE_DEV="$(lsblk -no pkname "$LIVE_PART" 2>/dev/null | head -n1 || true)"
fi

[ -b "/dev/$TARGET" ] || { echo "ERROR: /dev/$TARGET is not a block device" >&2; exit 1; }
[ "$TARGET" = "$LIVE_DEV" ] && { echo "ERROR: refusing to install onto the live USB" >&2; exit 1; }

DEV="/dev/$TARGET"
case "$DEV" in
  *nvme*|*mmcblk*) PFX="${DEV}p" ;;
  *)               PFX="$DEV" ;;
esac

if [ -d /sys/firmware/efi ]; then MODE=uefi; else MODE=bios; fi

DEB_ARCH="$(dpkg --print-architecture)"
case "$DEB_ARCH" in
  amd64) EFI_TARGET=x86_64-efi; EFI_GRUB=grubx64.efi;  EFI_BOOT=BOOTX64.EFI  ;;
  i386)  EFI_TARGET=i386-efi;   EFI_GRUB=grubia32.efi; EFI_BOOT=BOOTIA32.EFI ;;
  *)     echo "ERROR: unsupported architecture '$DEB_ARCH'" >&2; exit 1 ;;
esac

echo "Architecture  : $DEB_ARCH"
echo "Firmware mode : $MODE"
echo "Target disk   : $DEV"

echo "[1/6] Partitioning $DEV ..."
emit 0.02 "Partitioning disk"
swapoff -a || true
umount -R "${PFX}"* 2>/dev/null || true
wipefs -af "$DEV"
sgdisk --zap-all "$DEV" >/dev/null

EFI_PART=""
if [ "$MODE" = "uefi" ]; then
  parted -s "$DEV" mklabel gpt
  parted -s "$DEV" mkpart bios_boot 1MiB 2MiB
  parted -s "$DEV" set 1 bios_grub on
  parted -s "$DEV" mkpart ESP fat32 2MiB 514MiB
  parted -s "$DEV" set 2 esp on
  parted -s "$DEV" mkpart root ext4 514MiB 100%
  EFI_PART="${PFX}2"
  ROOT_PART="${PFX}3"
else
  parted -s "$DEV" mklabel msdos
  parted -s "$DEV" mkpart primary ext4 1MiB 100%
  parted -s "$DEV" set 1 boot on
  ROOT_PART="${PFX}1"
fi

partprobe "$DEV" || true
udevadm settle || sleep 2

for _ in {1..20}; do
  if [ -b "$ROOT_PART" ]; then break; fi
  sleep 0.5
done
[ -b "$ROOT_PART" ] || { echo "ERROR: $ROOT_PART did not appear after partitioning" >&2; exit 1; }

echo "[2/6] Formatting filesystems ..."
emit 0.07 "Formatting filesystems"
if [ -n "$EFI_PART" ]; then
  mkfs.fat -F32 -n EFI "$EFI_PART"
fi
mkfs.ext4 -F -L arcader "$ROOT_PART"

MNT=/mnt/install
mkdir -p "$MNT"
mount "$ROOT_PART" "$MNT"
if [ -n "$EFI_PART" ]; then
  mkdir -p "$MNT/boot/efi"
  mount "$EFI_PART" "$MNT/boot/efi"
fi

echo "Stopping arcaderd on the live system before copy ..."
ARCADER_UID="$(id -u arcader 2>/dev/null || echo '')"
if [ -n "$ARCADER_UID" ]; then
  sudo -u arcader XDG_RUNTIME_DIR="/run/user/$ARCADER_UID" \
    systemctl --user stop arcaderd.service 2>/dev/null || true
fi
pkill -u arcader -x arcaderd 2>/dev/null || true
pkill -u arcader -x arcaderui 2>/dev/null || true
sleep 1

echo "[3/6] Copying system to disk (this can take a few minutes) ..."
emit 0.10 "Scanning system files…"
COPY_LO=0.10
COPY_HI=0.85
RSYNC_STATUS=0
rsync -aAXH --no-inc-recursive --info=progress2 \
  --exclude='/proc/*' \
  --exclude='/sys/*' \
  --exclude='/dev/*' \
  --exclude='/run/*' \
  --exclude='/tmp/*' \
  --exclude='/mnt/*' \
  --exclude='/media/*' \
  --exclude='/lib/live' \
  --exclude='/var/cache/apt/archives/*' \
  --exclude='/var/lib/arcader/data/temp_*' \
  --exclude='/var/lib/arcader/data/*_extract' \
  --exclude='/etc/fstab' \
  --exclude='/boot/efi/*' \
  / "$MNT/" \
  | stdbuf -oL tr '\r' '\n' \
  | while IFS= read -r line; do
      if [[ "$line" =~ ([0-9]+)% ]]; then
        pct="${BASH_REMATCH[1]}"
        frac=$(awk -v lo="$COPY_LO" -v hi="$COPY_HI" -v p="$pct" \
          'BEGIN{printf "%.4f", lo + (hi - lo) * p / 100}')
        emit "$frac" "Copying system to disk — ${pct}%"
      fi
    done || RSYNC_STATUS=$?

case "$RSYNC_STATUS" in
  0|23|24) ;;
  *) echo "ERROR: copying the system failed (rsync exit $RSYNC_STATUS)" >&2; exit 1 ;;
esac

mkdir -p "$MNT"/{proc,sys,dev,run,tmp,mnt,media}

ROOT_UUID="$(blkid -s UUID -o value "$ROOT_PART")"
cat > "$MNT/etc/fstab" <<EOF
UUID=$ROOT_UUID  /          ext4  defaults,noatime           0  1
tmpfs            /tmp       tmpfs defaults,nosuid,nodev      0  0
EOF

if [ -n "$EFI_PART" ]; then
  EFI_UUID="$(blkid -s UUID -o value "$EFI_PART")"
  cat >> "$MNT/etc/fstab" <<EOF
UUID=$EFI_UUID   /boot/efi  vfat  defaults,umask=0077        0  0
EOF
fi

mkdir -p "$MNT/etc/arcader"
cat > "$MNT/etc/arcader/display.conf" <<EOF
ROTATE=$ROTATE
KEYMAP=$KEYMAP
EOF

cat > "$MNT/etc/default/keyboard" <<EOF
XKBMODEL="pc105"
XKBLAYOUT="$KEYMAP"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
EOF

echo "[4/6] Preparing chroot ..."
emit 0.86 "Preparing chroot"
mount --bind /dev     "$MNT/dev"
mount --bind /dev/pts "$MNT/dev/pts"
mount -t proc  proc   "$MNT/proc"
mount -t sysfs sys    "$MNT/sys"
mount -t tmpfs tmpfs  "$MNT/run"
if [ "$MODE" = "uefi" ]; then
  mount --bind /sys/firmware/efi/efivars "$MNT/sys/firmware/efi/efivars" 2>/dev/null || true
fi

echo "[5/6] Installing bootloader ($MODE) and regenerating initramfs ..."
emit 0.88 "Removing live-boot components"
POSTINST=/root/arcader-postinstall.sh
mkdir -p "$MNT/root"
cat > "$MNT$POSTINST" <<EOC
#!/bin/bash
set -e

apt-get -y purge live-boot live-boot-doc live-config live-config-systemd live-tools 2>/dev/null || true
apt-get -y autoremove --purge 2>/dev/null || true

printf '@@P 0.91 %s\n' 'Regenerating initramfs'
update-initramfs -u -k all

cat > /etc/default/grub <<EOG
GRUB_DEFAULT=0
GRUB_TIMEOUT=0
GRUB_TIMEOUT_STYLE=hidden
GRUB_DISTRIBUTOR="Arcader"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=3 vt.global_cursor_default=0 rd.systemd.show_status=false systemd.show_status=false udev.log_level=3 rd.udev.log_level=3"
GRUB_CMDLINE_LINUX=""
GRUB_DISABLE_RECOVERY=true
GRUB_DISABLE_OS_PROBER=true
EOG

printf '@@P 0.94 %s\n' 'Installing GRUB bootloader'
if [ "$MODE" = "uefi" ]; then
  [ -d /usr/lib/grub/$EFI_TARGET ] || { echo "ERROR: /usr/lib/grub/$EFI_TARGET is missing (grub EFI modules not installed)" >&2; exit 1; }
  grub-install --target=$EFI_TARGET --efi-directory=/boot/efi --bootloader-id=arcader --recheck
  mkdir -p /boot/efi/EFI/BOOT
  cp /boot/efi/EFI/arcader/$EFI_GRUB /boot/efi/EFI/BOOT/$EFI_BOOT
else
  [ -d /usr/lib/grub/i386-pc ] || { echo "ERROR: /usr/lib/grub/i386-pc is missing (grub-pc-bin not installed)" >&2; exit 1; }
  grub-install --target=i386-pc --recheck "$DEV"
fi
printf '@@P 0.96 %s\n' 'Writing GRUB configuration'
update-grub

echo "installed=\$(date -Iseconds)" > /etc/arcader-installed

mkdir -p /var/lib/systemd/linger
: > /var/lib/systemd/linger/arcader

rm -rf /var/lib/arcader/data/temp_cores_extract \
       /var/lib/arcader/data/temp_* \
       /var/lib/arcader/data/*_extract 2>/dev/null || true
EOC

chmod 755 "$MNT$POSTINST"
chroot "$MNT" /usr/bin/env DEBIAN_FRONTEND=noninteractive bash -e "$POSTINST" </dev/null
rm -f "$MNT$POSTINST"

echo "[6/6] Unmounting ..."
emit 0.98 "Flushing and unmounting"
sync
umount -lR "$MNT" || true

echo "Install complete."
exit 0
